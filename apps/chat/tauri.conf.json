{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veydan Chat",
  "version": "5.1.10",
  "identifier": "net.veydan.chat",
  "build": {
    "beforeDevCommand": "node ../scripts/ui.mjs chat dev",
    "devUrl": "http://localhost:1480",
    "beforeBuildCommand": "node ../scripts/ui.mjs chat build",
    "frontendDist": "../../data/build/chat"
  },
  "app": {
    "windows": [
      {
        "title": "Veydan Chat",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "frame-src": "'none'",
        "object-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost http://127.0.0.1:* data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost http://127.0.0.1:* blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1480 http://localhost:1480",
        "frame-src": "'none'",
        "object-src": "'none'"
      },
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Veydan Project",
    "license": "LicenseRef-PolyForm-Perimeter-1.0.1",
    "copyright": "Copyright 2026 Veydan Project",
    "category": "Productivity",
    "longDescription": "Veydan Chat is a messenger on Nostr: direct messages and groups, end-to-end encrypted.",
    "linux": {
      "deb": {
        "desktopTemplate": "linux/veydanchat.desktop",
        "files": {
          "/usr/share/doc/veydan-chat/copyright": "../../LICENSE"
        },
        "depends": ["libayatana-appindicator3-1"]
      },
      "rpm": {
        "desktopTemplate": "linux/veydanchat.desktop",
        "files": {
          "/usr/share/licenses/veydan-chat/LICENSE": "../../LICENSE"
        },
        "depends": ["libappindicator-gtk3"]
      },
      "appimage": {
        "files": {
          "/usr/share/doc/veydan-chat/copyright": "../../LICENSE"
        }
      }
    },
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJERjRFQjU3RjI5REYwMDQKUldRRThKM3lWK3YwdlZpQzNFbTlVTkZZb3NZbEhRZ1VucE96Q3JmUTZZYVE0SUpjbzBoLzBjWlQK",
      "endpoints": [
        "https://github.com/veydanproject/Veydan-Chat/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
