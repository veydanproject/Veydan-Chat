{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veydan Chat",
  "identifier": "net.veydan.chat",
  "build": {
    "devUrl": "http://localhost:1490",
    "frontendDist": "../../data/build/chat-android"
  },
  "app": {
    "windows": [
      {
        "title": "Veydan Chat",
        "width": 420,
        "height": 860
      }
    ],
    "security": {
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' asset: http://asset.localhost blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:1491 http://127.0.0.1:1490 ws://localhost:1491 http://localhost:1490",
        "frame-src": "'none'",
        "object-src": "'none'"
      }
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "android": {
      "minSdkVersion": 26,
      "versionCode": 2050111
    }
  }
}
